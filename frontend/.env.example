# frontend/.env.example — copy to frontend/.env and fill in
# DO NOT commit frontend/.env
#
# Leave this set to a real origin. An empty value used to become `undefined/api`.
# The PWA also falls back to window.location.origin, then http://127.0.0.1:8000.

WDS_SOCKET_PORT=
REACT_APP_BACKEND_URL=http://127.0.0.1:8000
