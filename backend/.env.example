# backend/.env.example — copy to backend/.env and fill in your keys
# DO NOT commit backend/.env

# Paste the same keys in the app: Settings → Bring your keys (no restart).
# .env is the fallback when the UI has not saved a user key yet.

MONGO_URL=
DB_NAME=
YOUTUBE_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
CHANNEL_ID=

# Optional. When set, write/admin routes require header X-Control-Token.
# Leave empty for local demo. Paste the same value in the app: Settings → Control token.
CONTROL_TOKEN=